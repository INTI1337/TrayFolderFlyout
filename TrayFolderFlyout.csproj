<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>TrayFolderFlyout</ApplicationTitle>
    <AssemblyName>TrayFolderFlyout</AssemblyName>
    <RootNamespace>TrayFolderFlyout</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="TrayFolderFlyout.Setup\**" />
    <Compile Remove="Publish\**" />
    <Compile Remove="Release\**" />
    <Page Remove="TrayFolderFlyout.Setup\**" />
    <Page Remove="Publish\**" />
    <Page Remove="Release\**" />
    <Resource Remove="TrayFolderFlyout.Setup\**" />
    <Resource Remove="Publish\**" />
    <Resource Remove="Release\**" />
    <None Remove="TrayFolderFlyout.Setup\**" />
    <None Remove="Publish\**" />
    <None Remove="Release\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <None Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TrayFolderFlyout.Launcher\**" />
    <Page Remove="TrayFolderFlyout.Launcher\**" />
    <Resource Remove="TrayFolderFlyout.Launcher\**" />
    <None Remove="TrayFolderFlyout.Launcher\**" />
  </ItemGroup>

</Project>
