<Window x:Class="TrayFolderFlyout.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка TrayFolderFlyout"
        Width="500" Height="340"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <!-- Fluent Dark CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBorder" Width="18" Height="18" CornerRadius="4" 
                                    Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path x:Name="CheckMark" Data="M3,9 L7,13 L15,5" Stroke="#FFFFFF" StrokeThickness="2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" Margin="1,1,0,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#6366F1"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#818CF8"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Flat Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Progress Bar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#6366F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Drop Shadow -->
    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Title Bar / Header (Draggable) -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="TrayFolderFlyout Setup" Foreground="#71717A" FontSize="11.5" 
                               VerticalAlignment="Center" Margin="14,0,0,0"/>

                    <Button Content="✕" Width="32" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" Foreground="#71717A" BorderThickness="0" Cursor="Hand"
                            FontSize="11" Margin="0,0,6,0" Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#E11D48"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Center Content -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0">
                <!-- App Icon with High Quality scaling -->
                <Image Source="pack://application:,,,/Assets/app.ico" Width="52" Height="52" 
                       HorizontalAlignment="Center" Margin="0,0,0,8"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"/>

                <!-- Title & Version -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleText" Text="Установка TrayFolderFlyout" Foreground="#F4F4F5" FontSize="16" FontWeight="SemiBold"/>
                    <Border Background="#27272A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="v1.2.0" Foreground="#A1A1AA" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Subtitle -->
                <TextBlock x:Name="HeaderSubtitleText" Text="Кастомные компактные папки на панели задач Windows 11" 
                           Foreground="#A1A1AA" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,14"/>

                <!-- Options Checkboxes (Visible before install) -->
                <StackPanel x:Name="OptionsPanel" HorizontalAlignment="Left" Width="360" Margin="0,0,0,0">
                    <CheckBox x:Name="DesktopShortcutCheckBox" Content="Создать ярлык на Рабочем столе" IsChecked="True"/>
                    <CheckBox x:Name="AutoRunCheckBox" Content="Запускать фоновую службу вместе с Windows" IsChecked="True"/>
                </StackPanel>

                <!-- Progress / Status (Visible during & after install) -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Width="360" Margin="0,4,0,0">
                    <TextBlock x:Name="StatusTextBlock" Text="Подготовка..." Foreground="#D4D4D8" FontSize="12" Margin="0,0,0,6"/>
                    <ProgressBar x:Name="InstallProgressBar" Height="6" Maximum="100" Value="0"/>
                </StackPanel>
            </StackPanel>

            <!-- Bottom Action Bar -->
            <Border Grid.Row="2" Background="#141416" BorderBrush="#27272A" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="16,10">
                <Grid>
                    <TextBlock Text="© 2026 TrayFolderFlyout" Foreground="#52525B" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" 
                                Margin="0,0,8,0" Click="CloseButton_Click"/>
                        
                        <Button x:Name="InstallButton" Content="Установить" Style="{StaticResource PrimaryButtonStyle}" 
                                Width="120" Height="34" Click="InstallButton_Click"/>

                        <Button x:Name="LaunchButton" Content="🚀 Запустить TrayFolderFlyout" Style="{StaticResource SuccessButtonStyle}" 
                                Visibility="Collapsed" Height="34" Padding="16,0" Click="LaunchButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
