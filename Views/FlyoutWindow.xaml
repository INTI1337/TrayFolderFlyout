<Window x:Class="TrayFolderFlyout.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayFolderFlyout"
        Icon="/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">

    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="FlyoutTransform" Y="10"/>
        </Grid.RenderTransform>

        <!-- Main Acrylic Container -->
        <Border x:Name="MainBorder"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{StaticResource GlassBorderStrongBrush}"
                Background="#E618181B"
                Padding="12"
                ContextMenuOpening="MainBorder_ContextMenuOpening">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Direction="270" Color="#000000"/>
            </Border.Effect>

            <!-- Background Context Menu -->
            <Border.ContextMenu>
                <ContextMenu x:Name="FlyoutContextMenu" Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                    <MenuItem Header="➕ Добавить файл..." Click="MenuAddFile_Click"/>
                    <MenuItem Header="📁 Добавить папку..." Click="MenuAddFolder_Click"/>
                    <MenuItem Header="🌐 Добавить ссылку (URL)..." Click="MenuAddUrl_Click"/>
                    <Separator/>
                    <MenuItem Header="🎨 Сменить иконку папки..." Click="MenuChangeIcon_Click"/>
                    <MenuItem Header="⚙️ Настроить эту папку в Менеджере" Click="MenuConfigure_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/> <!-- Thin strip: click to reveal the header -->
                    <RowDefinition Height="*"/>  <!-- Items Grid -->
                </Grid.RowDefinitions>

                <!-- Thin strip above the panel. Invisible by design: it only hints itself on hover,
                     so the flyout looks like a clean grid of icons. -->
                <Border x:Name="TopGrip"
                        Grid.Row="0"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonUp="TopGrip_MouseLeftButtonUp"
                        MouseEnter="TopGrip_MouseEnter"
                        MouseLeave="TopGrip_MouseLeave">
                    <Border x:Name="GripHandle"
                            Width="24" Height="3"
                            CornerRadius="1.5"
                            Background="#66FFFFFF"
                            Opacity="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>

                <!-- Header: hidden by default, revealed by a click on the strip. It overlays the grid
                     instead of pushing it down, so the window never resizes or jumps on toggle. -->
                <Border x:Name="HeaderOverlay"
                        Grid.Row="0" Grid.RowSpan="2"
                        Panel.ZIndex="20"
                        VerticalAlignment="Top"
                        Visibility="Collapsed"
                        Opacity="0"
                        Background="#F218181B"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="11,11,0,0"
                        Padding="12,5,12,5"
                        MouseEnter="HeaderOverlay_MouseEnter"
                        MouseLeave="HeaderOverlay_MouseLeave">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="HeaderTransform" Y="-8"/>
                    </Border.RenderTransform>

                    <Grid Height="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Back Button -->
                            <ColumnDefinition Width="*"/>    <!-- Title -->
                            <ColumnDefinition Width="Auto"/> <!-- Action Buttons (Settings, Close) -->
                        </Grid.ColumnDefinitions>

                        <!-- Back Button -->
                        <Button x:Name="BackButton"
                                Grid.Column="0"
                                Style="{StaticResource SubtleIconButtonStyle}"
                                Width="26" Height="26"
                                Margin="0,0,6,0"
                                Visibility="Collapsed"
                                Click="BackButton_Click"
                                ToolTip="Назад">
                            <TextBlock Text="←" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Button>

                        <!-- Folder Title & Icon -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="HeaderGroupIcon"
                                   Width="16" Height="16"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="HeaderTitleText"
                                       Text="Папка"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="220"/>
                        </StackPanel>

                        <!-- Header Right Icons: [⚙] [✕] -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Settings button -->
                            <Button Style="{StaticResource SubtleIconButtonStyle}"
                                    Width="26" Height="26"
                                    Margin="0,0,3,0"
                                    Click="MenuConfigure_Click"
                                    ToolTip="Настройки папки">
                                <TextBlock Text="⚙" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>

                            <!-- Explicit Close button with red hover -->
                            <Button Style="{StaticResource CloseIconButtonStyle}"
                                    Width="26" Height="26"
                                    Click="CloseButton_Click"
                                    ToolTip="Закрыть (Esc)"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. ITEMS GRID CONTAINER -->
                <ScrollViewer Grid.Row="1"
                              x:Name="ItemsScrollViewer"
                              MaxHeight="480"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              FocusVisualStyle="{x:Null}">
                    <ItemsControl x:Name="ItemsHost">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid x:Name="ItemsGrid" Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource FluentButtonStyle}"
                                        Width="{Binding CardWidth}"
                                        Height="{Binding CardHeight}"
                                        Padding="2"
                                        Margin="2"
                                        Click="Item_Click"
                                        MouseRightButtonUp="Item_RightClick"
                                        MouseDown="Item_MouseDown"
                                        ToolTip="{Binding TargetPath}">
                                    <Grid Margin="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Item Icon -->
                                        <Image Grid.Row="0"
                                               Source="{Binding Icon}"
                                               Width="{Binding IconSize}" Height="{Binding IconSize}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <!-- Item Label (if enabled) -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Name}"
                                                   Visibility="{Binding LabelVisibility}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="11"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="28"
                                                   LineHeight="14"
                                                   Margin="0,3,0,0"/>
                                    </Grid>

                                    <!-- Item Context Menu -->
                                    <Button.ContextMenu>
                                        <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                                            <MenuItem Header="▶️ Запустить" Click="MenuItemRun_Click"/>
                                            <MenuItem Header="🛡️ Запустить от имени администратора" Click="MenuItemRunAdmin_Click"/>
                                            <MenuItem Header="📂 Открыть расположение файла" Click="MenuItemOpenLocation_Click"/>
                                            <Separator/>
                                            <MenuItem Header="✏️ Переименовать" Click="MenuItemRename_Click"/>
                                            <MenuItem Header="🎨 Сменить иконку" Click="MenuItemChangeIcon_Click"/>
                                            <Separator/>
                                            <MenuItem Header="❌ Удалить из этой папки" Click="MenuItemDelete_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Drag & Drop Overlay Hint -->
                <Border x:Name="DropOverlay"
                        Grid.Row="1"
                        CornerRadius="8"
                        Background="#A06366F1"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="2"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="➕" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Перетащите файлы сюда"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Empty state hint -->
                <TextBlock x:Name="EmptyStateText"
                           Grid.Row="1"
                           Text="Папка пуста&#x0a;Перетащите сюда файлы или ярлыки"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           FontSize="12"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="24,32"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
