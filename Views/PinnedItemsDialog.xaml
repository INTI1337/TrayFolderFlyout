<Window x:Class="TrayFolderFlyout.Views.PinnedItemsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Закреплённые значки"
        Width="460" Height="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        KeyDown="Window_KeyDown">

    <Border x:Name="DialogBorder"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#33FFFFFF"
            Background="#F0202023"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Text="Закреплённые значки"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"/>

            <TextBlock x:Name="HintText"
                       Grid.Row="1"
                       Text="Панель задач и меню «Пуск». Отметьте, что добавить в папку."
                       FontSize="12"
                       Foreground="#AAAAAA"
                       Margin="0,4,0,10"
                       TextWrapping="Wrap"/>

            <Border Grid.Row="2" CornerRadius="8" Background="#1AFFFFFF" Padding="4">
                <Grid>
                    <ListBox x:Name="ItemsList"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             FocusVisualStyle="{x:Null}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="row" Background="Transparent" CornerRadius="6" Padding="6,4">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="#18FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,10,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                                            <TextBlock Text="{Binding Source}" Foreground="#8A8A8A" FontSize="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyText"
                               Text="Закреплённых значков не найдено"
                               Foreground="#8A8A8A"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Отмена"
                        Click="Cancel_Click"
                        Style="{StaticResource FluentButtonStyle}"
                        Padding="16,7"
                        Margin="0,0,8,0"/>
                <Button Content="Добавить"
                        Click="Ok_Click"
                        Style="{StaticResource FluentButtonStyle}"
                        Padding="16,7"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
