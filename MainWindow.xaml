<Window x:Class="TrayFolderFlyout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayFolderFlyout — Менеджер папок"
        Height="720" Width="1080"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. LEFT SIDEBAR (270px) -->
        <Border Grid.Column="0"
                Background="{StaticResource BgDarkSecondaryBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- App Header -->
                    <RowDefinition Height="Auto"/> <!-- + Создать папку button -->
                    <RowDefinition Height="*"/>    <!-- Folders List -->
                    <RowDefinition Height="Auto"/> <!-- AutoRun Toggle & Status -->
                </Grid.RowDefinitions>

                <!-- App Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30"
                                CornerRadius="8"
                                Background="{StaticResource AccentBrush}"
                                Margin="0,0,10,0">
                            <TextBlock Text="📁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TrayFolderFlyout"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Папки панели задач"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- + Создать папку button -->
                <Button Grid.Row="1"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,0,14"
                        HorizontalAlignment="Stretch"
                        Click="AddGroupButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="➕" Margin="0,0,8,0" FontSize="12"/>
                        <TextBlock Text="Создать новую папку"/>
                    </StackPanel>
                </Button>

                <!-- Folders List -->
                <ListBox Grid.Row="2"
                         x:Name="GroupsListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="GroupsListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="itemBorder"
                                                CornerRadius="10"
                                                Background="{StaticResource CardBgBrush}"
                                                BorderBrush="{StaticResource GlassBorderBrush}"
                                                BorderThickness="1"
                                                Padding="10,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource CardBgHoverBrush}"/>
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource GlassBorderStrongBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Folder Icon -->
                                <Image Grid.Column="0"
                                       Source="{Binding GroupIcon}"
                                       Width="34" Height="34"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <!-- Title & Count -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Delete Folder Button (on hover) -->
                                <Button Grid.Column="2"
                                        Style="{StaticResource CloseIconButtonStyle}"
                                        Width="24" Height="24"
                                        Click="DeleteGroupCardButton_Click"
                                        ToolTip="Удалить папку"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Sidebar Bottom: Windows Startup Switch & Config Management -->
                <Border Grid.Row="3"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        Padding="0,12,0,0">
                    <StackPanel>
                        <CheckBox x:Name="AutoRunCheckBox"
                                  Content="Запускать вместе с Windows"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12"
                                  Cursor="Hand"
                                  Margin="0,0,0,10"
                                  Click="AutoRunCheckBox_Click"/>

                        <!-- Backup / Restore / Config Directory Card -->
                        <Border CornerRadius="8" Background="{StaticResource SubtleCardBgBrush}" Padding="8,8" Margin="0,0,0,2">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource FluentButtonStyle}"
                                            Padding="2,5"
                                            Click="ExportConfigButton_Click"
                                            ToolTip="Экспорт всех папок и настроек в файл .json">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="📤" Margin="0,0,4,0" FontSize="11"/>
                                            <TextBlock Text="Экспорт" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource FluentButtonStyle}"
                                            Padding="2,5"
                                            Click="ImportConfigButton_Click"
                                            ToolTip="Импорт папок и настроек из файла .json">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="📥" Margin="0,0,4,0" FontSize="11"/>
                                            <TextBlock Text="Импорт" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Button Style="{StaticResource SubtleIconButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Padding="4,4"
                                        Click="OpenConfigFolderButton_Click"
                                        ToolTip="Открыть папку с файлами настроек в Проводнике">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📂" Margin="0,0,6,0" FontSize="11"/>
                                        <TextBlock Text="Открыть папку конфига" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. RIGHT PANEL (Interactive WYSIWYG Editor) -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="28,20">
                <StackPanel x:Name="DetailContainer">

                    <!-- TOP BLOCK: Icon + Inline Title + Action Buttons -->
                    <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                <ColumnDefinition Width="*"/>    <!-- Name & Info -->
                                <ColumnDefinition Width="Auto"/> <!-- Buttons -->
                            </Grid.ColumnDefinitions>

                            <!-- Clickable Icon -->
                            <Button Grid.Column="0"
                                    Width="64" Height="64"
                                    Margin="0,0,16,0"
                                    Cursor="Hand"
                                    Background="{StaticResource SubtleCardBgBrush}"
                                    BorderBrush="{StaticResource GlassBorderStrongBrush}"
                                    BorderThickness="1"
                                    Click="ChangeGroupIcon_Click"
                                    ToolTip="Нажмите, чтобы сменить иконку папки">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="iconBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="12">
                                            <Grid>
                                                <Image x:Name="IconImg"
                                                       Source="{Binding ElementName=GroupIconPreview, Path=Source}"
                                                       Width="44" Height="44"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <!-- Small pencil badge -->
                                                <Border CornerRadius="4"
                                                        Background="#B0000000"
                                                        Padding="3,1"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="3">
                                                    <TextBlock Text="✏" FontSize="9" Foreground="#FFFFFF"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="iconBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="iconBorder" Property="Background" Value="{StaticResource CardBgHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Image x:Name="GroupIconPreview" Visibility="Collapsed"/>

                            <!-- Name input & instructions -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <TextBox x:Name="GroupNameTextBox"
                                             FontSize="18"
                                             FontWeight="Bold"
                                             Style="{StaticResource FluentTextBoxStyle}"
                                             Padding="8,4"
                                             TextChanged="GroupNameTextBox_TextChanged"
                                             LostFocus="GroupNameTextBox_LostFocus"/>
                                    <TextBlock x:Name="GroupNamePlaceholder"
                                               Text="Без названия (необязательно)"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="10,4,0,0"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Нажмите на иконку слева, чтобы выбрать свой файл или готовый значок"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Actions: [📌 Закрепить в панели задач] [⚡ Тест Flyout] -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="PinToTaskbarButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="CreateShortcutButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📌" Margin="0,0,8,0" FontSize="13"/>
                                        <TextBlock Text="Закрепить в панели задач"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource FluentButtonStyle}"
                                        Click="TestFlyoutButton_Click"
                                        ToolTip="Открыть Flyout прямо сейчас">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" Margin="0,0,6,0" FontSize="12"/>
                                        <TextBlock Text="Тест Flyout"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SETTINGS SWITCHERS (Segmented visual buttons) -->
                    <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,16" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Folder Type -->
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/> <!-- Columns Count -->
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/> <!-- View Mode -->
                            </Grid.ColumnDefinitions>

                            <!-- 1. Folder Type Tabs -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ТИП ПАПКИ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,6"/>
                                <Border CornerRadius="8" Background="{StaticResource SubtleCardBgBrush}" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TypeVirtualRadio"
                                                     Content="Своя сборка"
                                                     GroupName="FolderType"
                                                     IsChecked="True"
                                                     Style="{StaticResource SegmentedRadioStyle}"
                                                     Click="TypeRadio_Click"/>
                                        <RadioButton x:Name="TypeSyncRadio"
                                                     Content="Папка на диске"
                                                     GroupName="FolderType"
                                                     Style="{StaticResource SegmentedRadioStyle}"
                                                     Click="TypeRadio_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 2. Columns Count Tabs -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="СЕТКА ИКОНОК" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,6"/>
                                <Border CornerRadius="8" Background="{StaticResource SubtleCardBgBrush}" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Col3Radio" Content="3 в ряд" GroupName="ColsGroup" Style="{StaticResource SegmentedRadioStyle}" Click="ColsRadio_Click"/>
                                        <RadioButton x:Name="Col4Radio" Content="4 в ряд" GroupName="ColsGroup" IsChecked="True" Style="{StaticResource SegmentedRadioStyle}" Click="ColsRadio_Click"/>
                                        <RadioButton x:Name="Col5Radio" Content="5 в ряд" GroupName="ColsGroup" Style="{StaticResource SegmentedRadioStyle}" Click="ColsRadio_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 3. View Mode Tabs -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="ВИД ЯРЛЫКОВ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,6"/>
                                <Border CornerRadius="8" Background="{StaticResource SubtleCardBgBrush}" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ViewLabelsRadio" Content="Иконка + подпись" GroupName="ViewGroup" IsChecked="True" Style="{StaticResource SegmentedRadioStyle}" Click="ViewRadio_Click"/>
                                        <RadioButton x:Name="ViewIconsOnlyRadio" Content="Только крупные иконки" GroupName="ViewGroup" Style="{StaticResource SegmentedRadioStyle}" Click="ViewRadio_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Synchronized Path Row (if Type is Synchronized) -->
                    <Border x:Name="SyncPathCard" Style="{StaticResource FluentCardStyle}" Margin="0,0,0,16" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Путь к папке на диске:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,0,12,0"/>
                            <TextBox x:Name="SyncPathTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource FluentTextBoxStyle}"
                                     TextChanged="SyncPathTextBox_TextChanged"/>
                            <Button Grid.Column="2"
                                    Content="Обзор..."
                                    Style="{StaticResource FluentButtonStyle}"
                                    Margin="8,0,0,0"
                                    Click="BrowseSyncPath_Click"/>
                        </Grid>
                    </Border>

                    <!-- 3. LIVE WYSIWYG CANVAS -->
                    <Border CornerRadius="12"
                            Background="#D018181B"
                            BorderBrush="{StaticResource GlassBorderStrongBrush}"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Live Canvas Title -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Предпросмотр Flyout (Live WYSIWYG)"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text=" • порядок меняется перетаскиванием"
                                               FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="➕ Добавить файл..."
                                            Style="{StaticResource FluentButtonStyle}"
                                            Margin="0,0,6,0"
                                            Click="AddItemFile_Click"/>
                                    <Button Content="🌐 Ссылка (URL)..."
                                            Style="{StaticResource FluentButtonStyle}"
                                            Click="AddItemUrl_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Interactive Live Grid -->
                            <WrapPanel x:Name="LiveItemsWrapPanel" Margin="0,0,0,8">
                                <!-- Dashed Drop/Add Card -->
                                <Border x:Name="DropZoneCard"
                                        Width="140" Height="90"
                                        CornerRadius="10"
                                        Background="#0AFFFFFF"
                                        BorderBrush="#406366F1"
                                        BorderThickness="1.5"
                                        Margin="4"
                                        Cursor="Hand"
                                        AllowDrop="True"
                                        DragEnter="DropZone_DragEnter"
                                        DragOver="DropZone_DragOver"
                                        Drop="DropZone_Drop"
                                        MouseLeftButtonUp="DropZone_Click"
                                        ToolTip="Перетащите файлы сюда или нажмите для выбора">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6">
                                        <TextBlock Text="➕" FontSize="20" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="Перетащите сюда файлы"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="или нажмите"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TOAST BANNER NOTIFICATION (Slides down when shortcut created) -->
            <Border x:Name="ToastBanner"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,18,28,0"
                    CornerRadius="10"
                    Background="#F027272A"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1.5"
                    Padding="14,10"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📌" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Ярлык готов для панели задач!"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="В открывшемся Проводнике перетащите выделенный ярлык на панель задач Windows."
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   MaxWidth="380"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
